# ========================================================
# Stu.Ai - Environment Configuration Template (.env.example)
# Copy this file to .env and configure the values for your environment.
# ========================================================

# Server Port and Base URL
PORT=3001
APP_BASE_URL=http://localhost:5173
NODE_ENV=development

# --------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Drizzle ORM)
# --------------------------------------------------------
# Provide a standard PostgreSQL connection string.
# Examples:
#   Neon / Supabase: postgresql://user:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Local PostgreSQL: postgresql://postgres:password@localhost:5432/stuai
#   Embedded PGlite fallback (zero external setup): leave empty or use pglite://./data/stuai_pglite
DATABASE_URL=

# --------------------------------------------------------
# 2. Security & Sessions
# --------------------------------------------------------
# Secure random secrets for session cookies and OTP HMAC signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_32_byte_hex_string_for_production
OTP_HMAC_SECRET=change_this_to_another_random_32_byte_hex_string_for_hmac

# --------------------------------------------------------
# 3. Google Gemini AI API Configuration
# --------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Model options:
# Fast model for regular explanations, chat, and quick classification
GEMINI_MODEL_FAST=gemini-2.5-flash

# Accurate model for complex problem solving, step-by-step proofs, and quiz generation
GEMINI_MODEL_ACCURATE=gemini-2.5-pro

# Transcription model for audio-to-text dictation
GEMINI_MODEL_TRANSCRIBE=gemini-2.5-flash

# --------------------------------------------------------
# 4. Email Service Configuration (Verification & Reset)
# --------------------------------------------------------
# Option A: Resend API (Recommended for production)
RESEND_API_KEY=
EMAIL_FROM=Stu.Ai <noreply@yourdomain.com>

# Option B: Standard SMTP (alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# If neither Resend nor SMTP is configured in development,
# OTP verification codes are logged securely to the server terminal only.

# --------------------------------------------------------
# 5. Persistent Storage Configuration
# --------------------------------------------------------
# Storage provider: "local" (default persistent folder) or "s3" or "replit"
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage

# S3 Compatible Storage (optional, e.g. Cloudflare R2, AWS S3, MinIO)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --------------------------------------------------------
# 6. Upload & Rate Limits
# --------------------------------------------------------
MAX_FILES_PER_MESSAGE=20
MAX_IMAGE_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=25
MAX_TOTAL_PAYLOAD_MB=100
MAX_AUDIO_DURATION_SECONDS=120
MAX_JOB_CONCURRENCY=3
